[Unit]
Description=Paradox Community Website
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/paradox-site
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
EnvironmentFile=%h/paradox-site/.env

[Install]
WantedBy=default.target
